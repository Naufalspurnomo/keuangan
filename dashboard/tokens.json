      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
