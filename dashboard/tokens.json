          "value": -0.035,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Montserrat",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Montserrat",
        "fontSize": {
          "value": 0.9375,
          "unit": "rem"
        },
        "fontWeight": 400
