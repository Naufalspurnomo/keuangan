# ===========================================
# Financial Recording Bot - Environment Config
# ===========================================
# Copy this file to .env and fill in your values

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Configuration
# Spreadsheet ID is in the URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
GOOGLE_SHEET_NAME=Sheet1

# Path to Google Service Account JSON file
# Download from: Google Cloud Console > IAM & Admin > Service Accounts
SERVICE_ACCOUNT_FILE=service_account.json

# Optional: Groq API Key(s) (for AI text + audio)
# Get from: https://console.groq.com/
# Primary key (backward compatible)
# GROQ_API_KEY=your_primary_groq_api_key_here
# Secondary fallback key (used when primary gets 429/rate-limited)
# GROQ_API_KEY_SECONDARY=your_secondary_groq_api_key_here
# Advanced: comma-separated list (takes priority order)
# GROQ_API_KEYS=key1,key2,key3

# Agent rollout flags
INTENT_ROUTER_MODE=off
NL_QUERY_ENABLED=false
SEMANTIC_DEDUP_ENABLED=false
CONVERSATION_MEMORY_ENABLED=true
AGENT_AUDIT_BACKEND=local
# AGENT_AUDIT_PATH=data/agent_audit.jsonl
# CONVERSATION_MEMORY_PATH=data/conversation_memory.jsonl
# CONVERSATION_MEMORY_TTL_SECONDS=86400
# CONVERSATION_MEMORY_MAX_BYTES=5242880

# Fonnte - Unofficial Wrapper (Deprecated?)
FONNTE_TOKEN=your_fonnte_token_here

# WuzAPI (Unofficial Hosted API)
# Get from: Your WuzAPI Dashboard (SumoPod)
WUZAPI_DOMAIN=https://wuzapi-xxxxx.sumopod.my.id
WUZAPI_TOKEN=your_wuzapi_token_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Sender access control (optional)
# Comma-separated WhatsApp numbers/user ids
ALLOWED_SENDER_IDS=

# Group pending delegates/admins (optional)
# Delegates can continue other user's session only via reply to the correct prompt.
SESSION_DELEGATE_IDS=

# Group UX tuning (optional)
# Owner fast-follow window (seconds): text first, image follows shortly without reply.
OWNER_FAST_FOLLOW_SECONDS=3
IMAGE_GRACE_SECONDS=5
# Wait briefly for concurrent image/text webhooks, then pair only recent events.
SPLIT_EVENT_JOIN_SECONDS=2.5
SPLIT_EVENT_PAIR_WINDOW_SECONDS=30

# Production state persistence (recommended for Koyeb/ephemeral deploys)
# local/empty = local JSON + Google Sheets backup only
# postgres = durable external state backend for pending confirmations/dedup refs
STATE_STORE_BACKEND=local
# STATE_STORE_REQUIRED=1  # fail closed if external state cannot load/save
# STATE_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# STATE_STORE_KEY=default
# Mirrors successful Google Sheets transaction writes to Postgres. Set to off
# only for local development when you intentionally do not want the mirror.
LEDGER_STORE_BACKEND=postgres
# Keep Sheets reads until scripts/import_sheets_to_postgres.py --apply reports
# matching counts. Then set to postgres to reduce Google Sheets API reads.
LEDGER_READ_BACKEND=off
# Koyeb-only one-time bootstrap. Set to 365 for the recommended rolling import,
# deploy once, then remove it after logs report completion. Use all only when
# you intentionally want every historic transaction copied.
# LEDGER_BOOTSTRAP_IMPORT_DAYS=365
# DURABLE_INBOX_REQUIRED=1  # never acknowledge a webhook before durable capture
# INBOX_RETENTION_DAYS=14
